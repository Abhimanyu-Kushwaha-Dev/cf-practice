for i in range(int(input())):
    n,k=map(int,input().split())
    a=list(map(int,input().split()))
    b=list(map(int,input().split()))
    ans=k&1
    oa,ob=0,0
    for x in a:
        if x&1:
            oa+=1
    ea=(n-oa)
    for x in b:
        if x&1:
            ob+=1
    eb=(n-ob)
    if ans:
        print("YES") if (eb<=ea) else print("NO")
    else:
        print("YES") if (ob<=oa) else print("NO")