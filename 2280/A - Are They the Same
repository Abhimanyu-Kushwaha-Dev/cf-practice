for i in range(int(input())):
    n,k=map(int,input().split())
    a=list(map(int,input().split()))
    b=list(map(int,input().split()))
    ans=k%2
    ea,eb=0,0
    for x in a:
        if x%2==0:
            ea+=1
    oa=(n-ea)
    for x in b:
        if x%2==0:
            eb+=1
    ob=(n-eb)
    if ans==0:
        print("YES") if (ob<=oa) else print("NO")
    else:
        print("YES") if (eb<=ea) else print("NO")